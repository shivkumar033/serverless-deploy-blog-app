<%- include("partials/header") %>

<section>

    <h1>All Users</h1>

    <div class="grid">

        <% users.forEach(user => { %>

            <div class="card">

                <h2>
                    <%= user.name %>
                </h2>

                <p>
                    @<%= user.username %>
                </p>

                <p>
                    <%= user.email %>
                </p>

                <p>
                    <%= user.bio %>
                </p>

                <a href="/user/<%= user.username %>/blogs">
                    View User Blogs
                </a>

            </div>

        <% }) %>

    </div>

</section>

<%- include("partials/footer") %>